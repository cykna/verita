export struct Invite {
    address: string,
    peer: string,
    timestamp: int,
    valid: bool
}

export struct FoundInvite { invite: Invite, error: string }

export struct InviteSearch {
    invite: string,
    password: string,
}

export struct UIInvite {
    image: image,
    timestamp: string,
    valid: bool,
}
